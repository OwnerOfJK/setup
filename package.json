{
  "name": "setup",
  "packageManager": "pnpm@10.18.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "clean": "rm -rf apps/*/node_modules apps/*/dist packages/*/node_modules packages/*/dist",
    "dev": "pnpm --filter backend dev & pnpm --filter frontend dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "db:create": "pnpm --filter db db:create",
    "db:drop": "pnpm --filter db db:drop",
    "db:migrate": "pnpm --filter db db:migrate",
    "db:seed": "pnpm --filter db db:seed",
    "db:generate": "pnpm --filter db db:generate"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "c8": "^10.1.3",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
