{
  "name": "@setup/backend",
  "version": "0.0.0",
  "main": "app.js",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "pnpm run build && fastify start -l info dist/app.js",
    "build": "tsc --build",
    "watch": "tsc -w",
    "dev": "pnpm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"pnpm:watch\" \"pnpm:dev:start\"",
    "dev:start": "pnpm run build && fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js",
    "test": "pnpm db:seed && c8 pnpm run test:run",
    "test:run": "glob -c \"tsx --test\" \"./test/**/*.ts\"",
    "standalone": "pnpm run build && node dist/server.js",
    "lint": "eslint --ignore-pattern=dist",
    "lint:fix": "pnpm run lint -- --fix"
  },
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/env": "^5.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/session": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@fastify/under-pressure": "^9.0.3",
    "@sinclair/typebox": "^0.34.38",
    "close-with-grace": "^2.2.0",
    "concurrently": "^9.2.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.4.0",
    "fastify-cli": "^7.4.0",
    "fastify-plugin": "^5.0.1",
    "pg": "^8.16.3",
    "sanitize-filename": "^1.6.3",
    "@setup/db": "workspace:*",
    "@setup/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "fastify-tsconfig": "^3.0.0",
    "form-data": "^4.0.4",
    "glob": "^11.0.3",
    "neostandard": "^0.12.2",
    "testcontainers": "^11.7.1"
  }
}
